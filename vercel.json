{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/metrics",
      "destination": "/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__subpath=$1"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/((?!api|health|metrics).*)",
      "destination": "/index.html"
    }
  ]
}
