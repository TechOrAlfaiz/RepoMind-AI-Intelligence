# ==============================================
# RepoMind Environment Configuration Template
# ==============================================

# Application Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/repomind
REDIS_URL=redis://localhost:6379

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=repomind_code_chunks

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Security Secrets (Must be random, strong strings in production)
# SESSION_SECRET: Used to sign session cookies
SESSION_SECRET=change_me_to_a_secure_random_session_secret_at_least_32_characters
# TOKEN_ENCRYPTION_KEY: 32-byte hex string (64 hex characters) for AES-256-GCM encryption of GitHub access tokens
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LLM & Embedding Providers
OPENAI_API_KEY=your_openai_api_key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4o-mini

# Rate Limiting & Audit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
